<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.DohViewTab"
    x:TypeArguments="vms:DohViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock
                VerticalAlignment="Center"
                Margin="0,0,4,0"
                Text="{x:Static resx:ResUI.DohConcurrency}" />
            <TextBox
                x:Name="txtConcurrency"
                Width="60"
                Margin="0,0,8,0"
                Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Text="{x:Static resx:ResUI.TBDohProxy}" />
            <TextBox
                x:Name="txtProxy"
                Width="180"
                Margin="0,0,8,0"
                Text="{Binding ProxyUrl}"
                materialDesign:HintAssist.Hint="http://127.0.0.1:7890" />
            <TextBlock
                VerticalAlignment="Center"
                Margin="0,0,4,0"
                Text="{x:Static resx:ResUI.DohResolveType}" />
            <ComboBox
                x:Name="cmbResolveType"
                Width="80"
                Margin="0,0,8,0"
                SelectedIndex="{Binding ResolveType}">
                <ComboBoxItem Content="A" />
                <ComboBoxItem Content="AAAA" />
                <ComboBoxItem Content="A+AAAA" />
            </ComboBox>
            <Button
                Margin="0,0,4,0"
                Command="{Binding QueryCmd}"
                Content="{x:Static resx:ResUI.DohQuery}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding CopyResultsCmd}"
                Content="{x:Static resx:ResUI.menuEditCopy}" />
            <Button
                Margin="0,0,4,0"
                Click="OpenHosts_Click"
                Content="{x:Static resx:ResUI.EditHosts}" />
        </WrapPanel>

        <!-- 左：域名输入；右：DoH 服务器列表 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：域名输入（每行一个） -->
            <TextBox
                x:Name="txtDomain"
                Grid.Column="0"
                Margin="0,0,4,0"
                AcceptsReturn="True"
                Text="{Binding Domains, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                materialDesign:HintAssist.Hint="要查询的域名，每行一个" />

            <!-- 右：DoH 服务器列表（可增删） -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox
                        x:Name="txtNewDohUrl"
                        Width="240"
                        Margin="0,0,4,0"
                        Text="{Binding NewDohUrl, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="https://1.1.1.1/dns-query" />
                    <Button
                        Command="{Binding AddDohCmd}"
                        Content="{x:Static resx:ResUI.Add}" />
                </WrapPanel>

                <DataGrid
                    x:Name="lstDohUrls"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding DohUrls}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding}"
                            Header="{x:Static resx:ResUI.TBDohUrl}" />
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="6,0"
                                        Command="{Binding DataContext.RemoveDohCmd, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="{x:Static resx:ResUI.Remove}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- 结果 -->
        <DataGrid
            x:Name="lstResults"
            Grid.Row="2"
            Margin="0,0,0,6"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Extended"
            SelectionChanged="LstResults_SelectionChanged"
            ItemsSource="{Binding Results}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Address}"
                    Header="{x:Static resx:ResUI.DohResults}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Domain}"
                    Header="{x:Static resx:ResUI.TBDohDomain}" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Server}"
                    Header="{x:Static resx:ResUI.DohServer}" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Type}"
                    Header="{x:Static resx:ResUI.DohResolveType}" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Ttl}"
                    Header="TTL" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 进度 -->
        <TextBox
            Grid.Row="3"
            Height="90"
            Margin="0,6,0,0"
            AcceptsReturn="True"
            FontSize="11"
            IsReadOnly="True"
            Text="{Binding ProgressText}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</reactiveui:ReactiveUserControl>
